# Copy to .env (never commit .env).
# Public Firebase Web API key — the same value as the server's NEXT_PUBLIC_FIREBASE_API_KEY.
EXPO_PUBLIC_FIREBASE_API_KEY=
# Optional: point the app at a LAN/dev server instead of https://www.ninjagamesjo.com
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Where "Delete account" requests are emailed (required for store release).
EXPO_PUBLIC_SUPPORT_EMAIL=
